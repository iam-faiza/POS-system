PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>   # must be a replica set (Atlas works) for checkout transactions
JWT_SECRET=change-me-to-a-random-string-of-at-least-24-characters
POS_TIME_ZONE=Asia/Karachi
UPLOAD_DIR=uploads/products
UPLOAD_URL_BASE=/uploads

# Optional
# PIN_PEPPER=use-a-separate-long-random-secret  # defaults to JWT_SECRET when unset
# JWT_EXPIRES_IN=12h              # default 30d
# POS_TAX_RATE=5
# POS_MAX_DISCOUNT_PERCENT=100
# CORS_ALLOWED_ORIGINS=https://your-pos-domain.com   # required when NODE_ENV=production
# TRUST_PROXY=1                   # set when behind a reverse proxy/load balancer
